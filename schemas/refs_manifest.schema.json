{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "refs_manifest",
  "type": "object",
  "required": [
    "manuscript",
    "entries"
  ],
  "properties": {
    "manuscript": {
      "type": "string"
    },
    "manuscript_sha256": {
      "description": "sha256 of the audited manuscript's bytes — the case folder's content identity. Absent on manifests written before content hashing, which fall back to comparing the file name.",
      "type": [
        "string",
        "null"
      ]
    },
    "summary": {
      "type": "object"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "num",
          "raw",
          "status"
        ],
        "properties": {
          "num": {
            "type": "string"
          },
          "raw": {
            "type": "string"
          },
          "doi": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "year": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "retrieved",
              "provided",
              "paywalled",
              "mismatch",
              "no_doi",
              "unpublished",
              "error"
            ]
          },
          "reason": {
            "type": "string"
          },
          "resolver": {
            "type": [
              "string",
              "null"
            ]
          },
          "pdf_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "slug": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}