# --- confidentiality guardrails -------------------------------------------
# Never commit manuscripts under review or downloaded publisher PDFs.
*.pdf
*.docx
cases/
case/
demo_case/
out/
references/

# the one committed exception: the pre-generated demo report (no source PDFs)
!examples/demo/output/
!examples/demo/output/**

# --- python ----------------------------------------------------------------
__pycache__/
*.pyc
.venv/
dist/
build/
*.egg-info/
.pytest_cache/
.ruff_cache/

# --- misc ------------------------------------------------------------------
.DS_Store

# evaluation run artifacts (the scaffold and gold sets ARE tracked)
evals/runs/*
!evals/runs/.gitkeep

# --- local agent tooling ---------------------------------------------------
# Serena's project config + memories are machine-local and drift from the code;
# they are regenerated by onboarding rather than reviewed in PRs.
.serena/

# SDD scratch: ledgers, briefs, review packages. Git history is the record.
.superpowers/
